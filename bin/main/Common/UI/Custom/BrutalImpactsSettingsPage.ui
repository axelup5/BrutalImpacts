$Common = "Common.ui";

@PanelBackground = PatchStyle(Color: #141414);
@SectionBackground = PatchStyle(Color: #1d1d1d);
@SectionBorder = #7b1313;
@SectionTitleStyle = LabelStyle(FontName: "Secondary", FontSize: 20, TextColor: #ffffff);
@BodyLabelStyle = LabelStyle(FontSize: 18, TextColor: #f0f0f0);
@MutedLabelStyle = LabelStyle(FontSize: 18, TextColor: #c7c7c7);
@ValueLabelStyle = LabelStyle(FontName: "Mono", FontSize: 18, TextColor: #ffffff);
@ActionButtonStyle = TextButtonStyle(
    Default: (
        Background: PatchStyle(Color: #6f1111),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Hovered: (
        Background: PatchStyle(Color: #8d1515),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Pressed: (
        Background: PatchStyle(Color: #a91b1b),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Disabled: (
        Background: PatchStyle(Color: #363636),
        LabelStyle: (FontSize: 20, TextColor: #bababa, RenderBold: true, Alignment: Center)
    )
);
@SecondaryButtonStyle = TextButtonStyle(
    Default: (
        Background: PatchStyle(Color: #292929),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Hovered: (
        Background: PatchStyle(Color: #343434),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Pressed: (
        Background: PatchStyle(Color: #404040),
        LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, Alignment: Center)
    ),
    Disabled: (
        Background: PatchStyle(Color: #242424),
        LabelStyle: (FontSize: 20, TextColor: #8e8e8e, RenderBold: true, Alignment: Center)
    )
);
@SliderTrack = PatchStyle(Color: #2a2a2a, Border: 1);
@SliderFill = PatchStyle(Color: #8b1414, Border: 1);
@SliderHandle = PatchStyle(Color: #f4f4f4, Border: 1);
@TuningSliderStyle = SliderStyle(
    Background: @SliderTrack,
    Fill: @SliderFill,
    Handle: @SliderHandle,
    HandleWidth: 14,
    HandleHeight: 38
);
@NumberStyle = InputFieldStyle(FontName: "Mono", FontSize: 16, TextColor: #ffffff);

Group {
    LayoutMode: Center;
    Background: #080808(0.88);

    Group #RootPanel {
        Anchor: (Width: 860, Height: 860);
        LayoutMode: Top;
        Padding: (Left: 22, Top: 22, Right: 22, Bottom: 22);
        Background: @PanelBackground;
        OutlineColor: #9d1717;
        OutlineSize: 6;

        Group #Header {
            LayoutMode: Left;
            Anchor: (Height: 92, Bottom: 14);

            Group #HeaderText {
                LayoutMode: Top;
                FlexWeight: 1;
                Padding: (Right: 18);

                Label #Title {
                    Text: "Brutal Impacts";
                    Style: (FontName: "Secondary", FontSize: 34, TextColor: #ffffff);
                    Anchor: (Bottom: 8);
                }

                Label #Subtitle {
                    Text: "Welcome to the BrutalImpacts UI.";
                    Style: @BodyLabelStyle;
                    Anchor: (Height: 20);
                }

                Label #Subtitle2 {
                    Text: "Here, you can customize your experience. You can also use the command shortcuts.";
                    Style: @BodyLabelStyle;
                    Anchor: (Height: 20);
                }
            }

            Group #LogoFrame {
                Anchor: (Width: 100, Height: 100);
                Background: #222222;
                OutlineColor: #8b1414;
                OutlineSize: 2;
                Padding: (Left: 2, Top: 2, Right: 2, Bottom: 2);

                AssetImage #Logo {
                    Background: PatchStyle(TexturePath: "icon-256.png");
                    Anchor: (Full: 0);
                    HitTestVisible: false;
                }
            }
        }

        Group #PresetSection {
            LayoutMode: Top;
            Anchor: (Height: 124, Bottom: 12);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Label {
                Text: "Presets";
                Style: @SectionTitleStyle;
                Anchor: (Bottom: 10);
            }

            Group #PresetRow {
                LayoutMode: Left;
                Anchor: (Height: 42, Bottom: 10);

                TextButton #CleanPreset {
                    Text: "Clean";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #NormalPreset {
                    Text: "Normal";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #BrutalPreset {
                    Text: "BRUTAL";
                    Style: @ActionButtonStyle;
                    Anchor: (Width: 150);
                }
            }

            Group #PresetInfoRow {
                LayoutMode: Left;
                Anchor: (Height: 24);

                Label #PresetLabel {
                    Text: "Active Preset:";
                    Style: @MutedLabelStyle;
                    Anchor: (Right: 10);
                }

                Label #PresetValue {
                    Style: @ValueLabelStyle;
                    Anchor: (Right: 22);
                }

                Label #DebugLabel {
                    Text: "Debug:";
                    Style: @MutedLabelStyle;
                    Anchor: (Right: 10);
                }

                Label #DebugValue {
                    Style: @ValueLabelStyle;
                    Anchor: (Width: 70);
                }
            }
        }

        Group #TuningSection {
            LayoutMode: Top;
            Anchor: (Height: 412, Bottom: 12);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Label {
                Text: "Impact Settings";
                Style: @SectionTitleStyle;
                Anchor: (Bottom: 8);
            }

            Label {
                Text: "Using the sliders, you can adjust each variable individually to fine-tune the settings.";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 12);
            }

            Label #MinScaleLabel {
                Text: "Minimum Scale";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #MinScale {
                Min: 10;
                Max: 800;
                Step: 1;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 16);
            }

            Label #MaxScaleLabel {
                Text: "Maximum Scale";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #MaxScale {
                Min: 10;
                Max: 800;
                Step: 1;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 16);
            }

            Label #ScaleMultiplierLabel {
                Text: "Global Scale Multiplier";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #ScaleMultiplier {
                Min: 10;
                Max: 500;
                Step: 1;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 16);
            }

            Label #ParticleMultiplierLabel {
                Text: "Global Particle Multiplier";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #ParticleMultiplier {
                Min: 10;
                Max: 500;
                Step: 1;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 16);
            }

        }

        Group #ActionSection {
            LayoutMode: Top;
            Anchor: (Height: 150);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Group #ActionRow {
                LayoutMode: Left;
                Anchor: (Height: 42, Bottom: 10);

                TextButton #ApplyButton {
                    Text: "Apply";
                    Style: @ActionButtonStyle;
                    Anchor: (Width: 140, Right: 10);
                }

                TextButton #ReloadButton {
                    Text: "Reload JSON";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 170, Right: 10);
                }

                TextButton #DebugButton {
                    Text: "Toggle Debug";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #CloseButton {
                    Text: "Close";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 120);
                }
            }

            Label #StatusText {
                Style: @MutedLabelStyle;
                Anchor: (Height: 54);
            }
        }
    }
}
