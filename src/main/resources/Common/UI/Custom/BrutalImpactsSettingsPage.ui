$Common = "Common.ui";

@PanelBackground = PatchStyle(Color: #141414);
@SectionBackground = PatchStyle(Color: #1d1d1d);
@SectionBorder = #7b1313;
@SectionTitleStyle = LabelStyle(FontName: "Secondary", FontSize: 18, TextColor: #ffffff);
@BodyLabelStyle = LabelStyle(FontSize: 12, TextColor: #f0f0f0);
@MutedLabelStyle = LabelStyle(FontSize: 11, TextColor: #c7c7c7);
@ValueLabelStyle = LabelStyle(FontName: "Mono", FontSize: 12, TextColor: #ffffff);
@ActionButtonStyle = TextButtonStyle(
    Default: (
        Background: PatchStyle(Color: #6f1111),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Hovered: (
        Background: PatchStyle(Color: #8d1515),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Pressed: (
        Background: PatchStyle(Color: #a91b1b),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Disabled: (
        Background: PatchStyle(Color: #363636),
        LabelStyle: (FontSize: 13, TextColor: #bababa, RenderBold: true)
    )
);
@SecondaryButtonStyle = TextButtonStyle(
    Default: (
        Background: PatchStyle(Color: #292929),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Hovered: (
        Background: PatchStyle(Color: #343434),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Pressed: (
        Background: PatchStyle(Color: #404040),
        LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true)
    ),
    Disabled: (
        Background: PatchStyle(Color: #242424),
        LabelStyle: (FontSize: 13, TextColor: #8e8e8e, RenderBold: true)
    )
);
@SliderTrack = PatchStyle(Color: #2a2a2a, Border: 1);
@SliderFill = PatchStyle(Color: #8b1414, Border: 1);
@SliderHandle = PatchStyle(Color: #f4f4f4, Border: 1);
@TuningSliderStyle = SliderStyle(
    Background: @SliderTrack,
    Fill: @SliderFill,
    Handle: @SliderHandle,
    HandleWidth: 14,
    HandleHeight: 24
);
@NumberStyle = InputFieldStyle(FontName: "Mono", FontSize: 12, TextColor: #ffffff);

Group {
    LayoutMode: Center;
    Background: #080808(0.88);

    Group #RootPanel {
        Anchor: (Width: 860, Height: 700);
        LayoutMode: Top;
        Padding: (Left: 22, Top: 22, Right: 22, Bottom: 20);
        Background: @PanelBackground;
        OutlineColor: #9d1717;
        OutlineSize: 6;

        Group #Header {
            LayoutMode: Left;
            Anchor: (Height: 92, Bottom: 14);

            Group #HeaderText {
                LayoutMode: Top;
                FlexWeight: 1;
                Padding: (Right: 18);

                Label #Title {
                    Text: "Brutal Impacts";
                    Style: (FontName: "Secondary", FontSize: 34, TextColor: #ffffff);
                    Anchor: (Bottom: 8);
                }

                Label #Subtitle {
                    Text: "Tuning runtime de escala, densidad y depuracion de impactos";
                    Style: (FontSize: 16, TextColor: #d4d4d4, Wrap: true);
                    Anchor: (Height: 42);
                }
            }

            Group #LogoFrame {
                Anchor: (Width: 84, Height: 84);
                Background: #222222;
                OutlineColor: #8b1414;
                OutlineSize: 2;
                Padding: (Left: 8, Top: 8, Right: 8, Bottom: 8);

                AssetImage #Logo {
                    AssetPath: "../../../icon-256.png";
                    Anchor: (Full: 0);
                    HitTestVisible: false;
                }
            }
        }

        Group #PresetSection {
            LayoutMode: Top;
            Anchor: (Height: 124, Bottom: 12);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Label {
                Text: "Perfiles";
                Style: @SectionTitleStyle;
                Anchor: (Bottom: 10);
            }

            Group #PresetRow {
                LayoutMode: Left;
                Anchor: (Height: 42, Bottom: 10);

                TextButton #CleanPreset {
                    Text: "Clean";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #NormalPreset {
                    Text: "Normal";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #BrutalPreset {
                    Text: "BRUTAL";
                    Style: @ActionButtonStyle;
                    Anchor: (Width: 150);
                }
            }

            Group #PresetInfoRow {
                LayoutMode: Left;
                Anchor: (Height: 24);

                Label #PresetLabel {
                    Text: "Perfil activo";
                    Style: @MutedLabelStyle;
                    Anchor: (Width: 92, Right: 10);
                }

                Label #PresetValue {
                    Style: @ValueLabelStyle;
                    Anchor: (Width: 120, Right: 22);
                }

                Label #DebugLabel {
                    Text: "Debug";
                    Style: @MutedLabelStyle;
                    Anchor: (Width: 48, Right: 10);
                }

                Label #DebugValue {
                    Style: @ValueLabelStyle;
                    Anchor: (Width: 70);
                }
            }
        }

        Group #TuningSection {
            LayoutMode: Top;
            Anchor: (Height: 372, Bottom: 12);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Label {
                Text: "Ajustes de impacto";
                Style: @SectionTitleStyle;
                Anchor: (Bottom: 8);
            }

            Label {
                Text: "Los sliders guardan y aplican valores con dos decimales.";
                Style: @MutedLabelStyle;
                Anchor: (Bottom: 12);
            }

            Label #MinScaleLabel {
                Text: "Escala minima";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #MinScale {
                Min: 0.05;
                Max: 3.0;
                Step: 0.05;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 4);
            }

            Label #MinScaleValue {
                Style: @MutedLabelStyle;
                Anchor: (Bottom: 12);
            }

            Label #MaxScaleLabel {
                Text: "Escala maxima";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #MaxScale {
                Min: 0.10;
                Max: 5.0;
                Step: 0.05;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 4);
            }

            Label #MaxScaleValue {
                Style: @MutedLabelStyle;
                Anchor: (Bottom: 12);
            }

            Label #ScaleMultiplierLabel {
                Text: "Multiplicador global de escala";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #ScaleMultiplier {
                Min: 0.10;
                Max: 3.0;
                Step: 0.05;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 4);
            }

            Label #ScaleMultiplierValue {
                Style: @MutedLabelStyle;
                Anchor: (Bottom: 12);
            }

            Label #ParticleMultiplierLabel {
                Text: "Multiplicador global de particulas";
                Style: @BodyLabelStyle;
                Anchor: (Bottom: 4);
            }

            FloatSliderNumberField #ParticleMultiplier {
                Min: 0.10;
                Max: 3.0;
                Step: 0.05;
                NumberFieldMaxDecimalPlaces: 2;
                SliderStyle: @TuningSliderStyle;
                NumberFieldStyle: @NumberStyle;
                Anchor: (Height: 38, Bottom: 4);
            }

            Label #ParticleMultiplierValue {
                Style: @MutedLabelStyle;
                Anchor: (Bottom: 0);
            }
        }

        Group #ActionSection {
            LayoutMode: Top;
            Anchor: (Height: 150);
            Padding: (Left: 14, Top: 12, Right: 14, Bottom: 12);
            Background: @SectionBackground;
            OutlineColor: @SectionBorder;
            OutlineSize: 2;

            Group #ActionRow {
                LayoutMode: Left;
                Anchor: (Height: 42, Bottom: 10);

                TextButton #ApplyButton {
                    Text: "Aplicar";
                    Style: @ActionButtonStyle;
                    Anchor: (Width: 140, Right: 10);
                }

                TextButton #ReloadButton {
                    Text: "Recargar JSON";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 170, Right: 10);
                }

                TextButton #DebugButton {
                    Text: "Toggle Debug";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 150, Right: 10);
                }

                TextButton #CloseButton {
                    Text: "Cerrar";
                    Style: @SecondaryButtonStyle;
                    Anchor: (Width: 120);
                }
            }

            Label #StatusText {
                Style: (FontSize: 12, TextColor: #f3d6d6, Wrap: true);
                Anchor: (Height: 54);
            }
        }
    }
}
